{
  "name": "android-study-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite --host 127.0.0.1 --port 8790",
    "build": "node scripts/build-content.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8791",
